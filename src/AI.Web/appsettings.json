{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "DefaultProvider": "Ollama",
    "Agent": {
      "MaxIterations": 6,
      "ShellCommandTimeoutSeconds": 30,
      "StreamingChunkCharacterCount": 18,
      "StreamingChunkDelayMilliseconds": 20,
      "BasePrompt": "You are a careful coding assistant operating in a minimal agent loop.\nYou must reply with exactly one JSON object and no markdown fences.\nTo finish, reply with: {\"type\":\"final\",\"message\":\"...\"}.\nTo run a shell command, reply with:\n{\"type\":\"shell\",\"command\":\"...\",\"reason\":\"...\"}.\nKeep commands minimal, deterministic, and directly relevant to the task.\nAfter receiving a shell result, either request another shell command or return a final answer."
    },
    "Providers": {
      "Ollama": {
        "Name": "Ollama",
        "CompletionProvider": {
          "Mode": "OllamaApi",
          "Endpoint": "http://localhost:11434/api/chat",
          "DefaultModel": "gpt-oss:20b",
          "ApiKey": "",
          "ApiKeyHeaderName": "Authorization",
          "ApiKeyScheme": "Bearer",
          "TimeoutSeconds": 120,
          "Temperature": 0.2
        },
        "ModelProvider": {
          "Mode": "OllamaApi",
          "Endpoint": "http://localhost:11434",
          "ApiKey": "",
          "ApiKeyHeaderName": "Authorization",
          "ApiKeyScheme": "Bearer",
          "TimeoutSeconds": 120
        }
      },
      "AzureFoundry": {
        "Name": "AzureFoundry",
        "CompletionProvider": {
          "Mode": "AzureFoundry",
          "Endpoint": "",
          "DefaultModel": "",
          "ApiKey": "",
          "ApiKeyHeaderName": "api-key",
          "ApiKeyScheme": "",
          "TimeoutSeconds": 120,
          "Temperature": 0.2
        },
        "ModelProvider": {
          "Mode": "AzureFoundryDeployments",
          "Endpoint": "",
          "ApiKey": "",
          "ApiKeyHeaderName": "api-key",
          "ApiKeyScheme": "",
          "TimeoutSeconds": 120
        }
      }
    }
  }
}
